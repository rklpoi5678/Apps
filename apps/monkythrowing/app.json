{
  "expo": {
    "name": "Monky Propel",
    "slug": "monky-proper-game",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.youngikim.monkypropergame",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "200000",
      "bundleIdentifier": "com.youngikim.monkypropergame",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses camera for AR features",
        "NSMicrophoneUsageDescription": "This app uses microphone for audio recording"
      }
    },
    "android": {
      "versionCode": 200000,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4A90E2"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.youngikim.monkypropergame"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a8fbe75-ba97-453b-89d9-0efd77e01f93"
      }
    },
    "owner": "youngikim"
  }
}
